   "cell_type": "raw",
   "id": "cf15070b-3e39-4c43-88ff-63724dd3acad",
   "metadata": {},
   "source": [
    "implement pow(x, n), which calculates x raised to the power n (i.e., xn).\n",
    "\n",
    "Example 1:\n",
    "Input: x = 2.00000, n = 10\n",
    "Output: 1024.00000\n",
    "\n",
    "Example 2:\n",
    "Input: x = 2.10000, n = 3\n",
    "Output: 9.26100\n",
    "\n",
    "Example 3:\n",
    "Input: x = 2.00000, n = -2\n",
    "Output: 0.25000\n",
    "Explanation: 2-2 = 1/22 = 1/4 = 0.25\n",
    " \n",
    "\n",
    "Constraints:\n",
    "-100.0 < x < 100.0\n",
    "-231 <= n <= 231-1\n",
    "n is an integer.\n",
    "Either x is not zero or n > 0.\n",
    "-104 <= xn <= 104"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "bd44088e-b8df-470e-91a5-7fb5366df127",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def pow(self, x, n):\n",
    "        return x ** n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "430b7f42-2a65-4456-a3a8-2ee7dc34479a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1024.0\n"
     ]
    }
   ],
   "source": [
    "sol = Solution()\n",
    "x = 2.00000\n",
    "n = 10\n",
    "print(sol.pow(x, n))"
   ]
  },
  {
